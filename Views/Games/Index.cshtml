@model List<gamebox.Models.Game>
@{
    ViewData["Title"] = "Catalogue des Jeux - Gamebox";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 fw-bold text-dark mb-1">🎮 Catalogue des Jeux</h1>
            <p class="text-muted mb-0">Explorez les titres disponibles et définissez votre statut de progression.</p>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        @foreach (var game in Model)
        {
            <div class="col">
                <div class="card h-100 border-0 shadow-sm rounded-3 overflow-hidden">
                    @if (!string.IsNullOrEmpty(game.CoverUrl))
                    {
                        <img src="@game.CoverUrl" class="card-img-top" alt="@game.Title" style="height: 220px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="bg-light d-flex align-items-center justify-content-center" style="height: 220px;">
                            <span class="fs-1">🎮</span>
                        </div>
                    }

                    <div class="card-body d-flex flex-direction-column justify-content-between p-3">
                        <div>
                            <div class="d-flex justify-content-between align-items-start mb-1">
                                <h5 class="card-title fw-bold fs-6 mb-0 text-truncate" title="@game.Title">@game.Title</h5>
                                <span class="badge bg-warning text-dark ms-1">★ @(game.AverageRating > 0 ? game.AverageRating.ToString("0.0") : "N/A")</span>
                            </div>
                            <p class="card-text text-muted small mb-2">@game.Studio &bull; @(game.ReleaseYear > 0 ? game.ReleaseYear.ToString() : "-")</p>
                            <p class="card-text text-secondary small" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                @game.Description
                            </p>
                        </div>

                        <div class="mt-3 pt-2 border-top">
                            <a asp-action="Details" asp-route-id="@game.Id" class="btn btn-outline-primary btn-sm w-100 rounded-pill">
                                Voir la fiche & Définir le statut &rarr;
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
