@{
    ViewData["Title"] = "Accueil - Gamebox";
}

<div class="game-details-page">
    <div class="py-5 text-center rounded-4 border border-secondary border-opacity-25 p-4 p-md-5 mb-4" style="background: linear-gradient(135deg, #161b2e 0%, #0d111c 100%);">
        <div class="col-lg-8 mx-auto">
            <h1 class="display-5 fw-bold text-white mb-3">🎮 Bienvenue sur Gamebox</h1>
            <p class="lead text-secondary mb-4">
                Gamebox est votre plateforme de suivi et de critique de jeux vidéo. Classez vos jeux, suivez votre progression et tenez votre journal à jour !
            </p>
            <div class="d-flex flex-wrap justify-content-center gap-3">
                <a asp-controller="Games" asp-action="Search" class="btn btn-primary btn-lg px-4 rounded-pill">
                    🔍 Rechercher des jeux
                </a>
                <a asp-controller="Games" asp-action="Index" class="btn btn-outline-light btn-lg px-4 rounded-pill">
                    🎮 Explorer le catalogue
                </a>
            </div>
        </div>
    </div>

    <div class="card border border-primary border-opacity-25 rounded-3 p-4 bg-dark text-white shadow-sm mb-4">
        <div class="d-flex align-items-center gap-2 mb-2">
            <span class="badge bg-primary">Ticket GBX-8</span>
            <h5 class="fw-bold mb-0">Fonctionnalité : Définir le statut d'un jeu</h5>
        </div>
        <p class="text-secondary mb-3">
            En tant qu'utilisateur, vous pouvez désormais classer vos jeux en <strong>À jouer</strong> (ToPlay), <strong>En cours</strong> (Playing), <strong>Terminé</strong> (Completed) ou <strong>Abandonné</strong> (Dropped).
        </p>
        <div class="d-flex gap-3">
            <a asp-controller="Games" asp-action="Details" asp-route-id="1" class="btn btn-sm btn-outline-primary rounded-pill">
                Tester sur Baldur's Gate 3 &rarr;
            </a>
            <a asp-controller="Games" asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill">
                Voir tous les jeux du catalogue &rarr;
            </a>
        </div>
    </div>
</div>
