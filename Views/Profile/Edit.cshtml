@model gamebox.Models.Member

@{
    ViewData["Title"] = "Modifier le profil";
}

<style>
    .edit-profile-container {
        max-width: 600px;
        margin: 0 auto;
        background-color: #0b0f19;
        color: #ffffff;
        min-height: 100vh;
        padding: 2rem 1rem;
    }

    .form-label {
        font-weight: 500;
        color: #ddd;
    }
    
    .game-list-item {
        display: flex;
        align-items: center;
        background-color: #1a1d24;
        border-radius: 8px;
        padding: 0.75rem;
        margin-bottom: 0.5rem;
    }

    .game-cover {
        width: 50px;
        height: 50px;
        border-radius: 6px;
        object-fit: cover;
        margin-right: 1rem;
    }

    .game-title {
        flex-grow: 1;
        font-weight: 500;
        font-size: 1rem;
        margin: 0;
    }

    .btn-toggle-fav {
        background: none;
        border: none;
        color: #888;
        font-size: 1.5rem;
        transition: color 0.2s;
    }

    .btn-toggle-fav.active {
        color: #ff5722;
    }

    .btn-primary-custom {
        background-color: #ff5722;
        border: none;
        color: white;
        padding: 0.75rem 1.5rem;
        border-radius: 6px;
        font-weight: 600;
        width: 100%;
        margin-top: 1rem;
    }

    .btn-primary-custom:hover {
        background-color: #e64a19;
    }
</style>

<div class="edit-profile-container">
    <a asp-action="Index" class="text-decoration-none text-muted mb-4 d-inline-block">&#8592; Back to Profile</a>
    <h1 class="mb-4">Edit Profile</h1>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <form asp-action="Edit" method="post" enctype="multipart/form-data" class="mb-5">
        <div class="mb-4">
            <label for="avatarFile" class="form-label">Profile Picture</label>
            <input class="form-control bg-dark text-white border-secondary" type="file" id="avatarFile" name="avatarFile" accept="image/*">
            <small class="text-muted">Choose an image from your device to upload as your avatar.</small>
        </div>
        <button type="submit" class="btn-primary-custom">Save Avatar</button>
    </form>

    <h2 class="mb-3">Manage Favorites</h2>
    <p class="text-muted mb-4">Click the heart to add or remove games from your favorites.</p>
    
    <div class="game-list">
        @{
            var allGames = new List<gamebox.Models.Game>();
            allGames.AddRange(Model.FavoriteGames);
            foreach(var gs in Model.GameStatuses)
            {
                if (!allGames.Any(g => g.Id == gs.GameId))
                {
                    allGames.Add(gs.Game);
                }
            }
            // Sort to show favorites first
            allGames = allGames.OrderByDescending(g => Model.FavoriteGames.Any(fg => fg.Id == g.Id)).ToList();
        }

        @if (allGames.Any())
        {
            @foreach (var game in allGames)
            {
                bool isFav = Model.FavoriteGames.Any(g => g.Id == game.Id);
                <div class="game-list-item">
                    <img src="@game.CoverUrl" alt="@game.Title" class="game-cover" />
                    <h3 class="game-title">@game.Title</h3>
                    <button type="button" class="btn-toggle-fav @(isFav ? "active" : "")" data-game-id="@game.Id">
                        ♥
                    </button>
                </div>
            }
        }
        else
        {
            <p class="text-muted">You haven't added any games to your backlog yet. Search for games to add them here.</p>
        }
    </div>

    <h2 class="mb-3 mt-5">Manage Lists</h2>
    <div class="custom-list-manager">
        @if (Model.MyCustomLists.Any())
        {
            @foreach (var list in Model.MyCustomLists)
            {
                <div class="game-list-item d-flex justify-content-between align-items-center mb-2 p-3 bg-dark rounded border border-secondary" id="list-@list.Id">
                    <div>
                        <h4 class="mb-1">@list.Title</h4>
                        <p class="mb-0 text-muted small">@list.Description</p>
                    </div>
                    <button type="button" class="btn btn-outline-danger btn-sm btn-delete-list" data-list-id="@list.Id">
                        Delete
                    </button>
                </div>
            }
        }
        else
        {
            <p class="text-muted">You don't have any custom lists.</p>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.btn-toggle-fav').forEach(btn => {
            btn.addEventListener('click', function() {
                const gameId = this.getAttribute('data-game-id');
                const button = this;

                fetch('/Games/ToggleFavorite/' + gameId, {
                    method: 'POST',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                })
                .then(response => {
                    if (response.ok) {
                        return response.json();
                    }
                    throw new Error('Network response was not ok.');
                })
                .then(data => {
                    if (data && data.success) {
                        if (data.isFavorite) {
                            button.classList.add('active');
                        } else {
                            button.classList.remove('active');
                        }
                    }
                })
                .catch(error => console.error('Error toggling favorite:', error));
            });
        });

        document.querySelectorAll('.btn-delete-list').forEach(btn => {
            btn.addEventListener('click', function() {
                if (!confirm("Are you sure you want to delete this list?")) return;
                
                const listId = this.getAttribute('data-list-id');
                
                fetch('/Profile/DeleteList/' + listId, {
                    method: 'POST',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                })
                .then(response => {
                    if (response.ok) return response.json();
                    throw new Error('Network error');
                })
                .then(data => {
                    if (data.success) {
                        const item = document.getElementById('list-' + listId);
                        item.parentNode.removeChild(item);
                    }
                })
                .catch(error => console.error('Error deleting list:', error));
            });
        });
    </script>
}
